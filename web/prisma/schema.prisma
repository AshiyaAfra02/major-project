generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ScanType {
  URL
  TEXT
  NETWORK
}

enum Severity {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Scan {
  id           String      @id @default(cuid())
  type         ScanType
  input        String
  label        String
  isThreat     Boolean
  confidence   Float
  threatScore  Float
  severity     Severity    @default(NONE)
  mock         Boolean     @default(false)
  modelVersion String      @default("unknown")
  details      Json?
  isDemo       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  alerts       Alert[]

  @@index([createdAt])
  @@index([type, isThreat])
}

model Alert {
  id                String      @id @default(cuid())
  scanId            String?
  scan              Scan?       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  attackType        String
  severity          Severity
  status            AlertStatus @default(OPEN)
  recommendedAction String
  source            ScanType
  confidence        Float
  createdAt         DateTime    @default(now())
  resolvedAt        DateTime?

  @@index([status, createdAt])
  @@index([severity])
  @@index([scanId])
}

model ModelMetric {
  id              String   @id @default(cuid())
  modelKey        String   @unique
  name            String
  task            String
  dataset         String
  isBaseline      Boolean  @default(false)
  served          Boolean  @default(false)
  nTest           Int
  accuracy        Float
  precisionMacro  Float
  recallMacro     Float
  f1Macro         Float
  labels          Json
  confusionMatrix Json
  perClass        Json
  extra           Json?
  updatedAt       DateTime @updatedAt
}
