# Neon Postgres connection string (Step 5)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# FastAPI service URL (local first, Hugging Face Space later)
ML_SERVICE_URL="http://localhost:7860"

# Must match ML_API_KEY in ml-service. SERVER-SIDE ONLY: never prefix with NEXT_PUBLIC_.
ML_API_KEY="change-me-to-a-long-random-string"